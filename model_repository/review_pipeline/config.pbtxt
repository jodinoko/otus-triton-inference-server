name: "review_pipeline"
backend: "python"
max_batch_size: 0
version_policy { specific { versions: [1] } }
input [
  { name: "TEXT" data_type: TYPE_STRING dims: [1] }
]
output [
  { name: "LABEL" data_type: TYPE_INT64 dims: [1] },
  { name: "PROBABILITIES" data_type: TYPE_FP32 dims: [1, 2] },
  { name: "REPLY" data_type: TYPE_STRING dims: [1] },
  { name: "FINISH_REASON" data_type: TYPE_STRING dims: [1] }
]
instance_group [ { count: 1 kind: KIND_CPU } ]
parameters { key: "embeddings_model" value: { string_value: "embeddings" } }
parameters { key: "classifier_model" value: { string_value: "classifier" } }
parameters { key: "generation_model" value: { string_value: "generation" } }
parameters { key: "model_version" value: { string_value: "1" } }

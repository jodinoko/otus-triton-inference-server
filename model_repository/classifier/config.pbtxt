name: "classifier"
backend: "onnxruntime"
max_batch_size: 0
version_policy { specific { versions: [1] } }
input [
  { name: "EMBEDDING" data_type: TYPE_FP32 dims: [1, 384] }
]
output [
  { name: "LABEL" data_type: TYPE_INT64 dims: [1] },
  { name: "PROBABILITIES" data_type: TYPE_FP32 dims: [1, 2] }
]
instance_group [ { count: 1 kind: KIND_CPU } ]
